{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "src/navigation/AppNavigation.tsx", "src/constants/index.ts", "src/store/userSlice.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
